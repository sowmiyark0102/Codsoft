import pandas as pd
import numpy as np
from sklearn.metrics.pairwise import cosine_similarity
from sklearn.feature_extraction.text import CountVectorizer
movies = pd.DataFrame({
    "movieId": [1, 2, 3, 4, 5, 6],
    "title": [
        "Inception", "Interstellar", "The Dark Knight",
        "Avengers", "Titanic", "The Notebook"
    ],
    "genre": [
        "Sci-Fi Thriller", "Sci-Fi Drama", "Action Crime",
        "Action Superhero", "Romance Drama", "Romance"
    ]
})

ratings = pd.DataFrame({
    "userId": [1,1,1,2,2,3,3],
    "movieId": [1,2,3,2,4,5,6],
    "rating": [5,4,5,5,4,5,4]
})

vectorizer = CountVectorizer()
genre_matrix = vectorizer.fit_transform(movies["genre"])

content_similarity = cosine_similarity(genre_matrix)

def get_content_recommendations(movie_name, top_n=3):
    if movie_name not in movies["title"].values:
        return ["Movie not found!"]

    idx = movies[movies["title"] == movie_name].index[0]
    similarity_scores = list(enumerate(content_similarity[idx]))
    similarity_scores = sorted(similarity_scores, key=lambda x: x[1], reverse=True)

    recommendations = []
    for i in similarity_scores[1:top_n+1]:
        recommendations.append(movies.iloc[i[0]]["title"])

    return recommendations

user_movie_matrix = ratings.pivot_table(
    index="userId", columns="movieId", values="rating"
).fillna(0)

user_similarity = cosine_similarity(user_movie_matrix)

def get_collaborative_recommendations(user_id):
    if user_id not in user_movie_matrix.index:
        return []

    user_index = list(user_movie_matrix.index).index(user_id)
    similarity_scores = list(enumerate(user_similarity[user_index]))
    similarity_scores = sorted(similarity_scores, key=lambda x: x[1], reverse=True)

    recommendations = set()

    for sim_user in similarity_scores[1:3]:  
        similar_user_id = user_movie_matrix.index[sim_user[0]]

        liked_movies = ratings[
            (ratings["userId"] == similar_user_id) & (ratings["rating"] >= 4)
        ]["movieId"]

        for movie_id in liked_movies:
            movie_title = movies[movies["movieId"] == movie_id]["title"].values[0]
            recommendations.add(movie_title)

    return list(recommendations)
def hybrid_recommend(user_id, movie_name):
    content_rec = get_content_recommendations(movie_name)
    collab_rec = get_collaborative_recommendations(user_id)
    final_recommendations = list(set(content_rec + collab_rec))

    return final_recommendations[:5]
print("🎬 Welcome to Movie Recommendation System\n")

try:
    user_id = int(input("Enter User ID (1-3): "))
    movie_name = input("Enter a movie you like: ")

    results = hybrid_recommend(user_id, movie_name)

    print("\n🎯 Recommended Movies:")
    for movie in results:
        print("-", movie)

except:
    print("Invalid input! Please try again.")
